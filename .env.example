# ====================
# Mindawaker 环境变量
# 复制此文件为 .env 并填入你的密钥
# cp .env.example .env
# ====================

# --------------------------------------------
# LLM API Keys
# --------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=your-google-api-key

# --------------------------------------------
# 图像生成 API Keys
# --------------------------------------------
# 原界面的 image model password / API Key
# Flux 可填 API Key；火山引擎可填 AccessKey**SecretKey（兼容旧输入格式）
# 已分别配置下方服务专用密钥时，此项可留空
IMAGE_MODEL_PASSWORD=
# 火山引擎 (Jimeng T2I)
VOLC_ACCESS_KEY=your-volc-access-key
VOLC_SECRET_KEY=your-volc-secret-key
# 接口业务标识，不是密码
VOLC_REQ_KEY=jimeng_t2i_v40

# Flux (piapi.ai)
FLUX_API_KEY=your-flux-api-key

# --------------------------------------------
# TTS API Keys (可选)
# --------------------------------------------
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastasia
COQUI_TTS_MODEL=tts_models/en/vctk/vits

# --------------------------------------------
# 服务配置
# --------------------------------------------
CORS_ORIGINS=http://localhost:3000
HF_HOME=./cache/huggingface
LOG_LEVEL=INFO
LOG_DIR=app/assets/logs
